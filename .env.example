# Origen del backend, sin /v1 y sin "/" final. Deja UNA sola línea activa.

# Backend local (por defecto): corre `npm run start:dev` en el repo backend.
VITE_API_URL=http://localhost:3000

# Backend desplegado en Render (comenta la línea de arriba y descomenta esta).
# Render debe tener http://localhost:5173 en CORS_ORIGINS para aceptar tu front local.
# VITE_API_URL=https://dinno-backend.onrender.com

# Datos de ejemplo de mesas (Sebastián). "true" usa el mock en memoria de src/features/tables/api.mock.ts,
# con latencia de ~400 ms. Para probar estados: /mesas?mockError=list (error de carga), /mesas?mockEmpty (sin mesas)
# o /mesas?mockLatency=3000 (carga lenta).
# También activa el mock del estado Abierto/Cerrado (Sergio, src/features/restaurant-status/api.mock.ts), en cualquier
# pantalla del dashboard: ?mockClosed (empieza cerrado), ?mockError=restaurant-status-load (error al cargar),
# ?mockError=restaurant-status-save (error al guardar) y ?mockEmpty (sin mesas, así que cierra sin pedir confirmación).
# También activa el mock de la bitácora (Sergio, src/features/activity-log/api.mock.ts), con datos fijos:
# /bitacora?mockError=table-logs-load (error al cargar), /bitacora?mockTableLogsFull (200 filas, aviso del límite)
# y /bitacora?mockEmpty (sin mesas ni cambios).
# Los parámetros se combinan: /mesas?mockClosed&mockLatency=3000 o ?mockError=list,restaurant-status-save.
# Cualquier otro valor (o sin la variable) usa el backend real. En Vercel no se define.
VITE_USE_MOCKS=false

# Configuración pública de Firebase Authentication para la app web; estos valores no son secretos.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
